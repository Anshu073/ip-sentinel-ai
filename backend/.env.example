# SerpApi — used for google, google_shopping, and google_reverse_image
SERPAPI_KEY=your_serpapi_key_here

# Groq — used to draft the legal notice (falls back to a template if unset)
GROQ_API_KEY=your_groq_api_key_here

# Optional overrides
APP_HOST=0.0.0.0
APP_PORT=8000
CACHE_TTL_SECONDS=3600
RESCAN_INTERVAL_HOURS=6
WHOIS_TIMEOUT_SECONDS=8
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DATABASE_URL=sqlite:///./data/scanner.db
GROQ_MODEL=llama-3.1-8b-instant
